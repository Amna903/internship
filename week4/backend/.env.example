# Copy to .env (or run `python scripts/init_env.py`, which also generates secrets).
# NEVER commit a real .env file.

DJANGO_SECRET_KEY=replace-me
JWT_SIGNING_KEY=replace-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Origins allowed to submit CSRF-protected requests (the Next.js dev server proxies to Django).
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cookies get the Secure flag unless this is false. Keep true in any HTTPS deployment.
# With DJANGO_DEBUG=false the app refuses to start if this is false.
COOKIE_SECURE=false
# SameSite policy for every cookie (JWT, admin session, CSRF): Lax or Strict.
COOKIE_SAMESITE=Lax

# Production (DJANGO_DEBUG=false) refuses to start unless all of these are set explicitly:
#   DJANGO_SECRET_KEY and JWT_SIGNING_KEY (different random values, >= 32 chars),
#   DJANGO_ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS (no localhost defaults, no '*').

# Leave unset for SQLite (backend/db.sqlite3). For PostgreSQL (see docker-compose.yml):
# DATABASE_URL=postgres://healthprofile:healthprofile@localhost:5432/healthprofile

ACCESS_TOKEN_MINUTES=10
REFRESH_TOKEN_DAYS=7
ADMIN_SESSION_MINUTES=30
THROTTLE_LOGIN=10/min
THROTTLE_SIGNUP=20/hour
THROTTLE_PREDICTIONS=60/min
ENABLE_API_DOCS=true

# Synthetic demo accounts created by `python manage.py seed_demo`.
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
